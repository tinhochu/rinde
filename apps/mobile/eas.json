{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "PON_TU_APPLE_ID_AQUI", "ascAppId": "PON_TU_ASC_APP_ID_AQUI", "appleTeamId": "PON_TU_TEAM_ID_AQUI" },
      "android": { "serviceAccountKeyPath": "./pc-api-key.json", "track": "internal" }
    }
  }
}
