# Postgres — in Coolify this is set on each service; locally `docker compose -f docker-compose.dev.yml up -d` exposes 5433
DATABASE_URL=postgresql://rinde:rinde@localhost:5433/rinde

# Meta Model API (pending docs/key)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
# Serve recorded sample receipts when the Meta API is unavailable (demo safety net)
DEMO_RECEIPTS=1
# Where receipt photos are stored (Docker volume in production)
RECEIPTS_DIR=./.data/receipts

# Worker: cron expression for price snapshots (America/Bogota)
INGEST_CRON="0 5 * * *"
# Include Éxito (served from /io/api/; see docs/data-feasibility.md)
INGEST_EXITO=1

# Sign-in (Better Auth). Secret: `openssl rand -base64 32`. URL: where apps/web is served.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continuar con Google" appears only when both are set (Google Cloud → OAuth client, type Web;
# redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
