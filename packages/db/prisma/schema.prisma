generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RetailerSlug {
  exito
  jumbo
  d1
  carulla
}

/// Base unit a package size is normalized to, so prices compare per g / ml / unit.
enum BaseUnit {
  g
  ml
  unit
}

model Retailer {
  id        String            @id @default(cuid())
  slug      RetailerSlug      @unique
  name      String
  baseUrl   String
  products  RetailerProduct[]
  createdAt DateTime          @default(now())
}

/// A canonical product, shared across retailers when they sell the same EAN.
model Product {
  id         String            @id @default(cuid())
  ean        String?           @unique
  name       String
  brand      String?
  category   String?
  /// Normalized package size, e.g. 500 + g
  size       Decimal?          @db.Decimal(12, 3)
  unit       BaseUnit?
  isPrivateLabel Boolean       @default(false)
  listings   RetailerProduct[]
  matchedFrom ProductMatch[]   @relation("matchFrom")
  matchedTo   ProductMatch[]   @relation("matchTo")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

/// A retailer's own listing of a product (its SKU, name, URL).
model RetailerProduct {
  id           String             @id @default(cuid())
  retailerId   String
  retailer     Retailer           @relation(fields: [retailerId], references: [id])
  productId    String
  product      Product            @relation(fields: [productId], references: [id])
  externalId   String
  name         String
  url          String
  imageUrl     String?
  observations PriceObservation[]
  lastSeenAt   DateTime
  match        ProductMatch?

  @@unique([retailerId, externalId])
  @@index([productId])
}

/// A listing judged to be the same product as another product with a different barcode.
/// The listing is re-pointed to `toProduct`; `fromProduct` keeps its own barcode, so lookups by
/// that barcode follow this row. Kept so a wrong match can be seen and undone.
model ProductMatch {
  id                String          @id @default(cuid())
  retailerProductId String          @unique
  retailerProduct   RetailerProduct @relation(fields: [retailerProductId], references: [id], onDelete: Cascade)
  fromProductId     String
  fromProduct       Product         @relation("matchFrom", fields: [fromProductId], references: [id])
  toProductId       String
  toProduct         Product         @relation("matchTo", fields: [toProductId], references: [id])
  /// "muse" or "rules"
  by                String
  /// Muse's one-line reason, in Spanish; null for a rule match
  reason            String?
  matchedAt         DateTime        @default(now())

  @@index([fromProductId])
  @@index([toProductId])
}

/// Append-only price history. Every price shown to a user must come from a row here.
model PriceObservation {
  id                String          @id @default(cuid())
  retailerProductId String
  retailerProduct   RetailerProduct @relation(fields: [retailerProductId], references: [id])
  /// COP, integer pesos
  price             Int
  listPrice         Int?
  available         Boolean
  /// Units in stock as reported by the retailer, when available
  stock             Int?
  source            String
  sourceUrl         String
  observedAt        DateTime
  ingestRunId       String?
  ingestRun         IngestRun?      @relation(fields: [ingestRunId], references: [id])
  /// Set when the price was read from a receipt (source "community:receipt")
  receiptLineId     String?         @unique
  receiptLine       ReceiptLine?    @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)

  @@index([retailerProductId, observedAt(sort: Desc)])
  @@index([source, observedAt])
}

model IngestRun {
  id           String             @id @default(cuid())
  retailer     RetailerSlug
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  status       String             @default("running")
  itemsSeen    Int                @default(0)
  error        String?
  observations PriceObservation[]
}

enum PriceStatus {
  live
  snapshot
  /// Read from a contributor's receipt; never re-checked live
  reported
}

model ShoppingList {
  id          String             @id @default(cuid())
  /// Anonymous session id (no accounts in MVP)
  sessionId   String
  budget      Int
  city        String             @default("bogota")
  rawInput    String?
  /// COP weight per extra stop when choosing stores
  tripCost    Int                @default(10000)
  /// Set when the user accepts an "add a stop" trade-off
  forceStores RetailerSlug[]     @default([])
  items       ShoppingListItem[]
  baskets     OptimizedBasket[]
  decisions   TradeoffDecision[]
  createdAt   DateTime           @default(now())

  @@index([sessionId])
}

model ShoppingListItem {
  id              String       @id @default(cuid())
  listId          String
  list            ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// What the user wrote, verbatim
  rawText         String
  /// Normalized intent used for search, e.g. "arroz blanco"
  query           String
  brand           String?
  quantity        Decimal      @db.Decimal(12, 3)
  unit            BaseUnit
  essential       Boolean      @default(true)
  allowSubstitute Boolean      @default(true)
  /// Forces a specific listing
  pinnedListingId String?
  /// Removed from the plan by an accepted trade-off
  dropped         Boolean      @default(false)
  position        Int
}

model OptimizedBasket {
  id                  String         @id @default(cuid())
  listId              String
  list                ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  budget              Int
  /// Goods total in COP
  total               Int
  overBudget          Int            @default(0)
  stops               Int
  stores              RetailerSlug[]
  tripCost            Int
  baselineTotal       Int?
  /// Human-readable definition of the baseline the savings are measured against
  baselineDescription String?
  savings             Int?
  /// Best plan per stop count
  alternatives        Json
  /// Unavailable items with reasons, verification summary, etc.
  assumptions         Json
  items               BasketItem[]
  createdAt           DateTime       @default(now())
}

model BasketItem {
  id                 String          @id @default(cuid())
  basketId           String
  basket             OptimizedBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  listItemId         String
  retailer           RetailerSlug
  retailerProductId  String
  priceObservationId String
  /// COP per pack, as observed
  price              Int
  packs              Int
  lineTotal          Int
  priceStatus        PriceStatus
  observedAt         DateTime
  isSubstitute       Boolean         @default(false)
  reason             String
}

model TradeoffDecision {
  id          String       @id @default(cuid())
  listId      String
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Stable proposal key, e.g. "drop:<itemId>"
  proposalKey String
  decision    String
  createdAt   DateTime     @default(now())

  @@unique([listId, proposalKey])
}

/// A photographed receipt. Uniqueness of accepted receipts (image, invoice number, CUFE, header)
/// is enforced by partial unique indexes WHERE status = 'confirmed', created in raw SQL in the migration.
model Receipt {
  id                String        @id @default(cuid())
  contributorId     String
  contributor       Contributor   @relation(fields: [contributorId], references: [id])
  /// draft | confirmed | revoked
  status            String        @default("draft")
  store             RetailerSlug
  branch            String        @default("")
  purchasedAt       DateTime
  /// Printed total, COP
  total             Int?
  /// Normalized prefix + consecutive, e.g. "POS1234567890"
  invoiceNumber     String
  cufe              String?
  /// sha256 of store | branch | purchase minute | total
  headerFingerprint String
  /// sha256 of the uploaded file
  imageHash         String
  /// Deleted after 30 days; the hash is kept
  imagePath         String?
  /// Extraction came from a recorded demo fixture
  demo              Boolean       @default(false)
  /// photo | einvoice (read from the DIAN XML) | einvoice-pdf (the invoice's PDF, read like a photo)
  source            String        @default("photo")
  /// An e-invoice whose DIAN validation response matched its CUFE
  dianConfirmed     Boolean       @default(false)
  /// Pesos the lines may differ from the total and still add up (an e-invoice's rounding plus 1 per line)
  tolerance         Int           @default(1)
  lines             ReceiptLine[]
  rewards           RewardEvent[]
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?

  @@index([contributorId, createdAt])
  @@index([status, createdAt])
}

model ReceiptLine {
  id                String            @id @default(cuid())
  receiptId         String
  receipt           Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  position          Int
  /// "item" | "discount"
  kind              String            @default("item")
  /// As printed
  text              String
  code              String?
  /// Quantity in the receipt's sale unit (e.g. 0.845 kg)
  quantity          Decimal?          @db.Decimal(12, 3)
  /// unit | kg | g | l | ml
  saleUnit          String?
  unitPrice         Int?
  total             Int?
  /// unitPrice was computed as total ÷ quantity (the receipt printed only the total, or an e-invoice line of several units)
  priceDerived      Boolean           @default(false)
  /// ok | illegible | mismatch
  check             String
  /// Proposed or confirmed catalog listing
  retailerProductId String?
  /// ean | code | alias | search | produce | user
  matchedBy         String?
  produceSlug       String?
  editedByUser      Boolean           @default(false)
  excluded          Boolean           @default(false)
  accepted          Boolean           @default(false)
  observation       PriceObservation?
  rewards           RewardEvent[]

  @@index([receiptId])
}

/// Store + normalized line text → listing, learned from confirmations so repeat receipts skip the model.
model ReceiptAlias {
  id                String       @id @default(cuid())
  store             RetailerSlug
  text              String
  retailerProductId String
  hits              Int          @default(1)
  updatedAt         DateTime     @updatedAt

  @@unique([store, text])
}

/// Canonical produce items ("Banano"): the shared key stores' internal produce codes lack.
model ProduceItem {
  slug        String   @id
  name        String
  /// Normalized words a receipt line may use: "banano", "bananito", "guineo"
  aliases     String[]
  /// kg | unit
  defaultUnit String
}

model Contributor {
  id             String             @id @default(cuid())
  sessionId      String             @unique
  /// Set when the person signs in (Better Auth user id); all their devices share this contributor
  accountId      String?            @unique
  displayName    String?
  zone           String             @default("Medellín, Antioquia")
  /// Receipt scanning paused after repeated duplicate attempts
  suspendedUntil DateTime?
  receipts       Receipt[]
  rewards        RewardEvent[]
  badges         ContributorBadge[]
  duplicates     DuplicateAttempt[]
  addresses      ForwardingAddress[]
  intakes        InvoiceIntake[]
  createdAt      DateTime           @default(now())

}

/// Where a contributor forwards e-invoice emails: facturas+<token>@INBOUND_EMAIL_DOMAIN. Replacing it
/// deactivates the row and creates another; a merge on sign-in moves rows, so both addresses keep working.
model ForwardingAddress {
  id            String          @id @default(cuid())
  /// 10 random lowercase base32 characters
  token         String          @unique
  contributorId String
  contributor   Contributor     @relation(fields: [contributorId], references: [id])
  active        Boolean         @default(true)
  /// Emails counted on `countedOn` (Colombia day), for the 20-per-day limit
  emailsToday   Int             @default(0)
  countedOn     DateTime?
  intakes       InvoiceIntake[]
  createdAt     DateTime        @default(now())

  @@index([contributorId])
}

/// One forwarded email or uploaded file and what became of it. Never holds the email, the files or buyer data.
model InvoiceIntake {
  id            String             @id @default(cuid())
  /// Null while unresolved, and for emails to an unknown address
  contributorId String?
  contributor   Contributor?       @relation(fields: [contributorId], references: [id])
  addressId     String?
  address       ForwardingAddress? @relation(fields: [addressId], references: [id])
  /// email | upload
  via           String
  /// Resend's email id; unique so webhook retries are recorded once
  resendEmailId String?            @unique
  /// received | accepted | rejected | dropped
  status        String             @default("received")
  /// Rejection message shown to the person
  message       String?
  /// The draft created (first accepted invoice); drafts may be deleted later, so not a foreign key
  receiptId     String?
  /// One outcome per invoice when an email holds several: [{ status, code?, message?, receiptId?, store? }]
  results       Json?
  /// sha256 of each attachment, for tracing duplicates without keeping files
  fileHashes    String[]           @default([])
  /// Store of the accepted invoice, for the outcomes list
  store         RetailerSlug?
  replied       Boolean            @default(false)
  attempts      Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([contributorId, createdAt])
  @@index([status, createdAt])
}

/// Append-only points ledger; balances and rankings are sums over it.
model RewardEvent {
  id            String       @id @default(cuid())
  contributorId String
  contributor   Contributor  @relation(fields: [contributorId], references: [id])
  /// line | gap_bonus | produce_bonus | revoked
  kind          String
  points        Int
  label         String
  receiptId     String?
  receipt       Receipt?     @relation(fields: [receiptId], references: [id])
  receiptLineId String?
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([contributorId, createdAt])
}

model ContributorBadge {
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id])
  /// primera-factura | cazador-de-frutas | pionero | constante
  badge         String
  earnedAt      DateTime    @default(now())

  @@id([contributorId, badge])
}

model DuplicateAttempt {
  id                String      @id @default(cuid())
  contributorId     String
  contributor       Contributor @relation(fields: [contributorId], references: [id])
  /// image | invoice | cufe | header
  layer             String
  matchedReceiptId  String
  createdAt         DateTime    @default(now())

  @@index([contributorId, createdAt])
}

// ── Sign-in (Better Auth core tables; field names are the library's) ──

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// One row per way of signing in (email + password, Google, …)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Anonymous install counters, one row per day and kind of event: no device, session or user is stored.
/// event launch: detail app (opened from the home-screen icon) | browser; installed: prompt (our button) | menu
/// (the browser's own menu); guide: shown | snoozed | install-tap | copy-link. way: how that browser installs.
model InstallCount {
  day    DateTime @db.Date
  event  String
  detail String
  way    String
  count  Int      @default(0)

  @@id([day, event, detail, way])
}
